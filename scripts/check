#!/usr/bin/env bash
#
# AGL's gates. Everything that can say "this build is wrong" says it here.
#
#   scripts/check
#
# Every gate runs, every time: the run does not stop at the first failure, because knowing
# that three things are broken is worth more than knowing that one is. Each gate prints its
# own output under its own heading, then a PASS/FAIL line; a summary repeats the verdicts at
# the end. Exit status is 0 if every gate passed, 1 if any gate failed, 2 if the environment
# is not set up (missing .venv tooling).
#
# Gate 6 is a warning: it prints, it never fails the build.
#
# The tools come from .venv/bin by explicit path, so no activated virtualenv is required and
# the answer does not depend on what is on $PATH.

set -uo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)" || exit 2
cd -- "$REPO_ROOT" || exit 2

VENV_BIN="$REPO_ROOT/.venv/bin"
TOTAL_GATES=8

# Gate 5: the Codex CLI binary name, and the one directory allowed to contain it. The OpenAI
# adapter shells out to this binary instead of importing a Python SDK, so there is no import
# for .importlinter to contain - this grep is that contract's stand-in. See ARCHITECTURE.md,
# "Vendor containment".
# Not called CODEX_HOME: that is a real environment variable naming the Codex CLI's configuration
# and credential directory, which the paid-endpoint gate below redirects, and one file holding two
# meanings of that name is one `export` away from pointing a real `codex` at a source directory.
CODEX_BINARY="codex"
CODEX_ADAPTER_DIR="src/agl/adapters/openai/"

# Gate 6: the project's own module size convention, in *code* lines - see the gate for what that
# counts and what it does not. The value has never moved; what it measures has.
MAX_MODULE_LINES=300

# Gate 7: the package root, and what an import statement looks like at the start of a line.
AGL_INIT="src/agl/__init__.py"
IMPORT_STATEMENT='^[[:space:]]*(import|from)\b'

# Gate 8: the environment variables the repo-wide guard owns, the one file allowed to write them,
# and the path a throwaway probe module is written to and deleted from.
GUARDED_VARS="ANTHROPIC_BASE_URL ANTHROPIC_API_KEY OPENAI_BASE_URL OPENAI_API_KEY CODEX_HOME"
GUARD_OWNER="tests/conftest.py"
PROBE="tests/test_written_by_scripts_check_and_deleted_again.py"

case "${1:-}" in
    -h | --help)
        sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^#\{1,2\} \{0,1\}//'
        exit 0
        ;;
    "") ;;
    *)
        printf 'scripts/check: unexpected argument %s (this script takes none)\n' "$1" >&2
        exit 2
        ;;
esac

# ---------------------------------------------------------------------------------------------
# Presentation
# ---------------------------------------------------------------------------------------------

if [ -t 1 ]; then
    BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
else
    BOLD=''; DIM=''; RESET=''; RED=''; GREEN=''; YELLOW=''
fi

RULE_HEAVY="=============================================================================="
RULE_LIGHT="------------------------------------------------------------------------------"

# Parallel arrays: bash 3.2 (the system bash on macOS) has no associative arrays.
gate_names=()
gate_verdicts=()
gate_notes=()
failures=0

gate_header() { # number, title, command being run
    printf '\n%s\n' "$RULE_LIGHT"
    printf '%sGATE %s/%s  %s%s\n' "$BOLD" "$1" "$TOTAL_GATES" "$2" "$RESET"
    printf '%s$ %s%s\n' "$DIM" "$3" "$RESET"
    printf '%s\n\n' "$RULE_LIGHT"
}

record() { # name, verdict, note
    gate_names+=("$1")
    gate_verdicts+=("$2")
    gate_notes+=("$3")
    case "$2" in
        PASS) printf '\n%s  PASS%s  %s\n' "$GREEN" "$RESET" "$1" ;;
        WARN) printf '\n%s  WARN%s  %s - %s\n' "$YELLOW" "$RESET" "$1" "$3" ;;
        FAIL) printf '\n%s  FAIL%s  %s\n' "$RED" "$RESET" "$1"; failures=$((failures + 1)) ;;
    esac
}

record_status() { # name, exit-status, note
    if [ "$2" -eq 0 ]; then record "$1" PASS "$3"; else record "$1" FAIL "$3"; fi
}

# ---------------------------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------------------------

for tool in pytest mypy ruff lint-imports; do
    if [ ! -x "$VENV_BIN/$tool" ]; then
        printf '%sscripts/check: %s/%s is missing or not executable.%s\n' \
            "$RED" "$VENV_BIN" "$tool" "$RESET" >&2
        printf 'The gates run out of this repo'"'"'s .venv. Create it, then re-run:\n' >&2
        printf '    uv sync\n' >&2
        exit 2
    fi
done

printf '%s\n' "$RULE_HEAVY"
printf '%s AGL gates%s  %s\n' "$BOLD" "$RESET" "$REPO_ROOT"
printf '%s\n' "$RULE_HEAVY"

# ---------------------------------------------------------------------------------------------
# 1. Tests
# ---------------------------------------------------------------------------------------------

gate_header 1 "tests" ".venv/bin/pytest"
"$VENV_BIN/pytest"
record_status "pytest" $? ""

# ---------------------------------------------------------------------------------------------
# 2. Types
# ---------------------------------------------------------------------------------------------

gate_header 2 "types" ".venv/bin/mypy --strict src tests"
"$VENV_BIN/mypy" --strict src tests
record_status "mypy --strict" $? ""

# ---------------------------------------------------------------------------------------------
# 3. Lint
#
# Unused imports, undefined names, import order, dead style. Cheap to run and cheap to fix, and
# the thing that keeps eighty separate authors writing one codebase instead of eighty. Rules and
# exclusions live in pyproject.toml under [tool.ruff]; `reference/` is excluded there. This is a
# gate, not advice: a lint finding fails the build. No --fix - the build reports, it does not edit.
# ---------------------------------------------------------------------------------------------

gate_header 3 "lint" ".venv/bin/ruff check"
"$VENV_BIN/ruff" check
record_status "ruff check" $? ""

# ---------------------------------------------------------------------------------------------
# 4. Import contracts
# ---------------------------------------------------------------------------------------------

gate_header 4 "import contracts" ".venv/bin/lint-imports"
"$VENV_BIN/lint-imports"
record_status "lint-imports" $? ""

# ---------------------------------------------------------------------------------------------
# 5. Codex CLI binary containment
#
# The name of the binary the OpenAI adapter shells out to must not appear in any .py file
# outside src/agl/adapters/openai/. Matching is case-insensitive, so prose mentions count too.
# Only src/ is searched: the repo root and tests/ name the binary legitimately.
# ---------------------------------------------------------------------------------------------

gate_header 5 "Codex CLI binary containment" \
    "grep -rIn -i -e $CODEX_BINARY --include='*.py' src | grep -v ^$CODEX_ADAPTER_DIR"

codex_hits="$(grep -rIn -i -e "$CODEX_BINARY" --include='*.py' src 2>/dev/null || true)"
codex_inside="$(printf '%s' "$codex_hits" | grep -c "^${CODEX_ADAPTER_DIR}" || true)"
codex_stray="$(printf '%s' "$codex_hits" | grep -v "^${CODEX_ADAPTER_DIR}" || true)"

printf '%s matches inside %s (expected: that is where the binary is named)\n' \
    "$codex_inside" "$CODEX_ADAPTER_DIR"

if [ -n "$codex_stray" ]; then
    printf '%s matches elsewhere under src/ - every one of these is a violation:\n\n' \
        "$(printf '%s\n' "$codex_stray" | wc -l | tr -d ' ')"
    printf '%s\n' "$codex_stray" | sed 's/^/    /'
    printf '\nOnly %s may name the %s binary. Everywhere else, speak to it through the\n' \
        "$CODEX_ADAPTER_DIR" "$CODEX_BINARY"
    printf 'AgentRunner port instead.\n'
    record "codex containment" FAIL ""
else
    printf '0 matches elsewhere under src/.\n'
    record "codex containment" PASS ""
fi

# ---------------------------------------------------------------------------------------------
# 6. Module size ceiling (warning only)
#
# Nothing is excluded. A file over the ceiling is not a build failure; it is the project asking
# whether that module is still holding one idea. The count carries onto the summary line either
# way, so a reader who only reads the summary still sees a 400-line module appear.
#
# **A line, here, is a physical line carrying at least one token of code.** A line of code with a
# trailing comment counts once; a statement spread over five lines counts five; a multi-line string
# that is a *value* counts every line it spans, because a prompt template a module carries is
# something the module carries. Docstrings, comments and blank lines count zero. That is a much
# narrower rule than `wc -l`, and it moved this tree from 116 files over the ceiling to 31 - which
# is the point, not a side effect. Each exclusion is a separate decision and each is argued below,
# because a reader who cannot tell what a "line" means without opening the counter cannot tell what
# the number is claiming.
#
# **Docstrings are out, and that is the whole reason this gate was rewritten.** The question above
# is "is this module still holding one idea" - a question about what the module *does*, which a
# docstring is not. The measured cost of getting that wrong: `src/agl/sdk/params.py` landed at
# exactly 300 by `wc -l` after five compression passes, so the convention bought an author's time
# and caught nothing; it is 171 code lines, and was never near the ceiling in the sense the gate
# means. Against that, this build's prose has repeatedly been its best artifact - `ports/store.py`
# predicted its own global-lock hole in its docstring, and a missing `commit=` was found by reading
# a docstring's table against the code while all eight gates were green. A ceiling that
# charges for prose is a ceiling pushing in the wrong direction.
#
# Note the *attribute* docstring: a bare string statement after a dataclass field, which this repo
# uses everywhere and which `ast.get_docstring` cannot see. The counter walks `ast.Expr` whose value
# is a string constant, which catches both kinds - a rule worth stating because the obvious
# implementation misses most of the prose in this codebase and still looks right.
#
# **Comments are out, for the same reason.** In this repo a comment is usually prose carrying an
# argument, not a summary of the line below: this block, gate 8's five paragraphs, `.importlinter`'s
# contracts. If a comment cost a line and a docstring did not, an author near the ceiling would move
# an argument out of a comment and into a docstring - worse writing, chosen to satisfy a counter,
# which is precisely the failure the docstring exclusion exists to end.
#
# The case against, which is real: a commented-out block is code hiding from the counter, and
# nothing else in this build closes that hole - `ruff`'s ERA rules are not in `pyproject.toml`'s
# select list. It is left open knowingly. The cheap fix - count a comment line if it parses as
# Python - was tried on paper and rejected: `# run.step is the delegate` parses, and a counter that
# charges for a sentence because it happens to be a valid expression is a worse instrument than one
# with a known hole. Commented-out code is a review finding; module size is not the tool for it.
#
# **Blank lines are out, and this is the decision that set the number.** The case for keeping them
# is the best one on this list: blank lines are the one thing that honestly tracks how much of a
# screen a module fills, and unlike prose they cannot be argued away. The case against is a
# measurement. Under `tests/` - the half of this walk that carries prose today, `src/` having none
# - 4,195 of 12,929 blank lines, 32%, sit directly against a docstring line. They are the blank
# line PEP 8 asks for *because* a block of prose is there, and this repo puts one there every time.
# So counting blank lines does not measure bulk independently of prose; it re-charges for the prose
# at about a third rate, through a line the author did not choose. The rest tracks how many
# definitions a module has, which the code count already counts.
#
# (PEP 8 and habit, not a gate: `ruff`'s E3 blank-line rules are preview-only and are not in
# `pyproject.toml`'s select list, so nothing here would stop an author deleting those lines to get
# under a ceiling that counted them. Which is the argument a second time, from the other end.)
#
# **A module that counts zero is a legal answer, and two kinds of file reach it.** Every
# `__init__.py` under `src/` is empty - thirteen of them, `src/agl/__init__.py` and the twelve
# package roots below it - and an empty file counts nothing. `tests/contracts/__init__.py` and
# `tests/instruments/__init__.py` are the other kind, a docstring and nothing else, and prose counts
# zero by the rule above. Nothing here divides by the count, so zero is a number like any other;
# those files simply never appear.
#
# **A file that will not parse is counted at its full physical size and named.** Not skipped: a
# counter that silently drops what it cannot read is a fail-open, and this gate's whole job is to
# report a module that got big. Falling back to `wc -l` can only over-report, never hide, and the
# path is printed so nobody reads the number as a real one. Same for the counter failing outright -
# that records a WARN saying the counter did not run, rather than a clean "0 over", because the two
# must never look alike on the summary line.
# ---------------------------------------------------------------------------------------------

gate_header 6 "module size ceiling (warning only)" \
    "code lines in every .py under src/ and tests/, ceiling ${MAX_MODULE_LINES}"

size_report="$(
    AGL_MAX_MODULE_LINES="$MAX_MODULE_LINES" "$VENV_BIN/python" - <<'PY'
import ast
import io
import pathlib
import tokenize
from os import environ

ceiling = int(environ["AGL_MAX_MODULE_LINES"])

# Token types that are not code. COMMENT and NL (the blank-line/continuation newline) do the real
# work; NEWLINE closes a logical line whose own lines already counted; the rest are layout markers
# that carry no text of their own.
NOT_CODE = frozenset(
    {
        tokenize.COMMENT,
        tokenize.NL,
        tokenize.NEWLINE,
        tokenize.INDENT,
        tokenize.DEDENT,
        tokenize.ENDMARKER,
        tokenize.ENCODING,
    }
)

Span = tuple[tuple[int, int], tuple[int, int]]


def prose(tree: ast.Module) -> list[Span]:
    """Every docstring's (start, end) position - module, class and function docstrings, and the
    bare-string-after-a-field attribute docstrings this repo is written out of.

    Positions rather than line numbers, so a line holding a docstring *and* a statement after a
    semicolon is not lost along with the docstring, and so an implicitly concatenated docstring
    drops all of its pieces rather than only the first.
    """
    spans = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant):
            if isinstance(node.value.value, str):
                text = node.value
                start = (text.lineno, text.col_offset)
                end = (text.end_lineno or text.lineno, text.end_col_offset or 0)
                spans.append((start, end))
    return spans


def code_lines(source: str) -> int:
    spans = prose(ast.parse(source))
    lines: set[int] = set()
    for token in tokenize.generate_tokens(io.StringIO(source).readline):
        if token.type in NOT_CODE:
            continue
        if token.type == tokenize.STRING:
            if any(lo <= token.start and token.end <= hi for lo, hi in spans):
                continue
        lines.update(range(token.start[0], token.end[0] + 1))
    return len(lines)


rows: list[tuple[int, int, str]] = []
unparsed: list[str] = []
for root in ("src", "tests"):
    for path in sorted(pathlib.Path(root).rglob("*.py")):
        raw = path.read_bytes()
        physical = raw.count(b"\n")  # what `wc -l` would say
        try:
            counted = code_lines(raw.decode("utf-8"))
        except (SyntaxError, UnicodeDecodeError, ValueError, tokenize.TokenError):
            counted = physical
            unparsed.append(str(path))
        rows.append((counted, physical, str(path)))

over = sorted((row for row in rows if row[0] > ceiling), reverse=True)
print(len(over), len(rows), len(unparsed))

if over:
    print(f"Over {ceiling} code lines ({len(over)} of {len(rows)} files):\n")
    print(f"  {'code':>6}  {'total':>6}  file")
    for counted, physical, path in over:
        print(f"  {counted:6d}  {physical:6d}  {path}")
else:
    print(f"All {len(rows)} .py files under src/ and tests/ hold at most {ceiling} code lines.")

if unparsed:
    print(f"\n{len(unparsed)} file(s) would not parse. Each is counted at its full physical size")
    print("instead - the only direction that cannot hide one - and named here:")
    for path in unparsed:
        print(f"    {path}")
PY
)"
size_status=$?

if [ "$size_status" -ne 0 ] || [ -z "$size_report" ]; then
    printf '%s\n' "$size_report"
    printf 'The code-line counter did not run, so no module size was measured on this run.\n'
    printf 'That is not the same as nothing being oversized, and does not read the same either.\n'
    record "module size" WARN "counter did not run - no sizes measured"
else
    read -r over_count file_count unparsed_count <<<"$(printf '%s\n' "$size_report" | head -n 1)"
    printf '%s\n' "$size_report" | tail -n +2
    if [ "$over_count" -gt 0 ]; then
        printf '\nThis does not fail the build.\n'
        record "module size" WARN "$over_count of $file_count over $MAX_MODULE_LINES code lines"
    else
        record "module size" PASS "0 of $file_count over $MAX_MODULE_LINES code lines"
    fi
    if [ "$unparsed_count" -gt 0 ]; then
        printf '%s file(s) above are physical counts, not code counts.\n' "$unparsed_count"
    fi
fi

# ---------------------------------------------------------------------------------------------
# 7. The package root holds no imports
#
# The one hole in contract 5. import-linter skips any (source, forbidden) pair where one module
# is a descendant of the other, and agl.adapters is a descendant of agl - so an adapter imported
# in src/agl/__init__.py leaves all six contracts kept. Nothing in .importlinter can express it.
# Hence the blunt rule: that file holds no import statements at all. It is meant to stay empty; a
# later stage that genuinely needs a re-export there comes here and changes this. Deleting it is a
# different proposal and a refused one - tests/test_tree.py's docstring carries the measurement.
# ---------------------------------------------------------------------------------------------

gate_header 7 "package root holds no imports" \
    "grep -nE '$IMPORT_STATEMENT' $AGL_INIT"

if [ ! -f "$AGL_INIT" ]; then
    printf '%s does not exist. This gate has nothing to check, which is itself wrong.\n' "$AGL_INIT"
    record "package root" FAIL ""
else
    root_imports="$(grep -nE "$IMPORT_STATEMENT" "$AGL_INIT" || true)"
    if [ -n "$root_imports" ]; then
        printf '%s import statement(s) in %s - every one of these is a violation:\n\n' \
            "$(printf '%s\n' "$root_imports" | wc -l | tr -d ' ')" "$AGL_INIT"
        printf '%s\n' "$root_imports" | sed 's/^/    /'
        printf '\n%s is invisible to contract 5, because import-linter skips source/forbidden\n' \
            "$AGL_INIT"
        printf 'pairs that overlap - so this gate is the only thing guarding the package root.\n'
        printf 'The root package stays empty: put the import in the module that needs it.\n'
        record "package root" FAIL ""
    else
        printf 'No import statements in %s.\n' "$AGL_INIT"
        record "package root" PASS ""
    fi
fi

# ---------------------------------------------------------------------------------------------
# 8. No test module can reach a paid endpoint
#
# A test that spends a token is indistinguishable from one that does not: same green, a second
# slower. The last one was found by accident. So "no test in this repository reaches a paid
# endpoint" is not left to a docstring, and not left to a fixture either - it is measured here, on
# every run, in the two shapes it can fail.
#
# **A passing fixture is not evidence, and neither half below is one.** tests/conftest.py exports a
# loopback base URL, a dummy key and a scratch CODEX_HOME for every test in the suite; a gate that
# ran the suite and read the green tick would be asserting that the fixture which just ran, ran.
# Both halves are chosen because they fail in cases where every existing test still passes.
#
# Half one - the guard deleted, renamed, or lost in a conftest reshuffle. A probe module is written
# into tests/ now, run, and deleted. It imports nothing from the guard, names no fixture and opts
# into nothing, so it *is* the claim - a file added today is protected by default - rather than a
# restatement of it, and it does not care where the fixture lives or what it is called. It runs
# with the environment poisoned: ANTHROPIC_BASE_URL set to the real vendor endpoint,
# ANTHROPIC_API_KEY emptied (which is what makes the CLI reach for the operator's own OAuth bearer
# token), and CODEX_HOME pointed at a scratch directory holding a stand-in auth.json. The poison is
# what makes the probe non-vacuous: the machine this was written on already had
# ANTHROPIC_BASE_URL=https://api.anthropic.com in the ambient shell, so "the variable looked fine"
# would have been luck. Passing means the guard *overrode* a live endpoint. Nothing here starts a
# CLI or opens a socket to anything: the probe reads three environment variables and one file path.
#
# Half two - a test module quietly re-pointing a guarded variable. An AST scan of every .py under
# tests/ except the one file allowed to write them. It flags setenv/delenv/putenv/unsetenv naming a
# guarded variable, a subscript assignment or `del` keyed by one, os.environ.pop/setdefault/update
# naming one, any os.environ.clear(), and a dict literal keyed by one - which is the
# subprocess.run(env=...) shape. Parsed rather than grepped because the interesting version of this
# spans lines. What it cannot see is a variable name assembled at runtime, and nothing cheap could.
#
# **Codex is covered by credential removal and not by endpoint redirection**, and the probe checks
# the half that was measured: CODEX_HOME names a directory with no auth.json in it, so a `codex`
# any test starts has no ChatGPT token to send anywhere. There is deliberately no assertion about
# where Codex would send one - `codex --help` documents no endpoint environment variable, the
# endpoint is configuration, and proving a redirect works costs a `codex exec`.
#
# (Named, not numbered: gates get inserted, and the numbers move. tests/conftest.py and
# tests/adapters/test_claude_code_runner.py refer to this one as the paid-endpoint gate.)
# ---------------------------------------------------------------------------------------------

gate_header 8 "no test module can reach a paid endpoint" \
    "ast scan of tests/ for writes to the guarded variables, then $VENV_BIN/pytest on a probe module written into tests/ with the real endpoints poisoned"

guard_writes="$(
    AGL_GUARDED_VARS="$GUARDED_VARS" AGL_GUARD_OWNER="$GUARD_OWNER" "$VENV_BIN/python" - <<'PY'
import ast
import os
import pathlib

guarded = set(os.environ["AGL_GUARDED_VARS"].split())
owner = pathlib.Path(os.environ["AGL_GUARD_OWNER"])
writers = {"setenv", "delenv", "putenv", "unsetenv"}
mutators = {"pop", "setdefault", "update", "clear"}


def literals(call: ast.Call) -> set[str]:
    return {a.value for a in call.args if isinstance(a, ast.Constant) and isinstance(a.value, str)}


def is_environ(node: object) -> bool:
    return (isinstance(node, ast.Attribute) and node.attr == "environ") or (
        isinstance(node, ast.Name) and node.id == "environ"
    )


def bound(node: ast.AST) -> list[ast.expr]:
    if isinstance(node, ast.Assign | ast.Delete):
        return list(node.targets)
    if isinstance(node, ast.AnnAssign | ast.AugAssign):
        return [node.target]
    return []


found: list[tuple[str, int, str]] = []
for source in sorted(pathlib.Path("tests").rglob("*.py")):
    if source == owner:
        continue
    for node in ast.walk(ast.parse(source.read_text(encoding="utf-8"))):
        at = int(getattr(node, "lineno", 0))
        if isinstance(node, ast.Call):
            called = getattr(node.func, "attr", None) or getattr(node.func, "id", None)
            named = sorted(guarded & literals(node))
            if called in writers and named:
                found.append((str(source), at, f"{called}({named[0]!r}, ...)"))
            elif called in mutators and is_environ(getattr(node.func, "value", None)):
                if named or called == "clear":
                    found.append((str(source), at, f"os.environ.{called}({', '.join(named)})"))
        for target in bound(node):
            key = target.slice if isinstance(target, ast.Subscript) else None
            if isinstance(key, ast.Constant) and key.value in guarded:
                found.append((str(source), at, f"{key.value!r} rebound or deleted as a key"))
        if isinstance(node, ast.Dict):
            for key in node.keys:
                if isinstance(key, ast.Constant) and key.value in guarded:
                    found.append((str(source), at, f"{{{key.value!r}: ...}} - a composed environment"))

for where, at, what in sorted(set(found)):
    print(f"{where}:{at}: {what}")
raise SystemExit(1 if found else 0)
PY
)"
scan_status=$?

if [ -n "$guard_writes" ]; then
    printf '%s place(s) under tests/ write a guarded environment variable outside %s:\n\n' \
        "$(printf '%s\n' "$guard_writes" | wc -l | tr -d ' ')" "$GUARD_OWNER"
    printf '%s\n' "$guard_writes" | sed 's/^/    /'
    printf '\nOnly %s may write these: %s\n' "$GUARD_OWNER" "$GUARDED_VARS"
    printf 'A module that re-points one of them sends its subprocesses wherever it said, and the\n'
    printf 'guard cannot see it happen - the loopback records nothing and the teardown passes.\n'
else
    printf 'No module under tests/ writes any of these outside %s:\n    %s\n' \
        "$GUARD_OWNER" "$GUARDED_VARS"
fi

probe_home="$(mktemp -d)"
printf '{"note":"a stand-in for the operator credential store, written by scripts/check"}\n' \
    >"$probe_home/auth.json"
trap 'rm -f "$REPO_ROOT/$PROBE"; rm -rf "$probe_home"' EXIT INT TERM

cat >"$PROBE" <<'PY'
"""Written by `scripts/check` and deleted again: a module that did not exist when the guard did.

The claim is that a test file added today inherits the repo-wide paid-endpoint guard without
asking. Nothing here imports the guard, names its fixture, or opts into anything - so if this
passes, `tests/conftest.py` reached a module it has never heard of. `scripts/check` runs it with
the real endpoints poisoned into the environment, which is what makes passing mean the guard
*overrode* them rather than that this machine happened to be clean.
"""

import ipaddress
import os
from pathlib import Path
from urllib.parse import urlsplit


def test_a_module_written_today_inherits_the_paid_endpoint_guard() -> None:
    base = os.environ.get("ANTHROPIC_BASE_URL", "")
    host = urlsplit(base).hostname or ""
    try:
        loopback = ipaddress.ip_address(host).is_loopback
    except ValueError:
        loopback = False

    assert loopback, (
        f"ANTHROPIC_BASE_URL is {base!r} in a module that asked for nothing. scripts/check "
        f"poisoned it with the real vendor endpoint and the repo-wide guard did not override it, "
        f"so a `claude` started from any newly added test file goes straight to a paid endpoint"
    )
    assert os.environ.get("ANTHROPIC_API_KEY"), (
        "ANTHROPIC_API_KEY is empty here. That is not a missing precaution: it is what makes the "
        "CLI fall back to the operator's own OAuth bearer token and send it to whatever is "
        "listening on the redirected base URL"
    )
    home = os.environ.get("CODEX_HOME", "")
    assert home and not (Path(home) / "auth.json").is_file(), (
        f"CODEX_HOME is {home!r} and there is an auth.json in it. scripts/check poisoned it with a "
        f"stand-in for the operator's own credential store and the guard did not redirect it, so a "
        f"`codex` started from any newly added test file can read live ChatGPT tokens"
    )
PY

printf '\nProbe: %s, run with the endpoints poisoned.\n\n' "$PROBE"

ANTHROPIC_BASE_URL="https://api.anthropic.com" \
    ANTHROPIC_API_KEY= \
    CODEX_HOME="$probe_home" \
    "$VENV_BIN/pytest" "$PROBE" -q -p no:cacheprovider
probe_status=$?

rm -f "$PROBE"
rm -rf "$probe_home"
trap - EXIT INT TERM

if [ "$scan_status" -eq 0 ] && [ "$probe_status" -eq 0 ]; then
    record "paid-endpoint guard" PASS ""
else
    if [ "$probe_status" -ne 0 ]; then
        printf '\nThe probe module was written into tests/ moments ago and asked for nothing. It\n'
        printf 'inherits whatever %s gives every test - and on this run that was not\n' "$GUARD_OWNER"
        printf 'enough to keep a paid endpoint out of reach. Every test file in the repository is\n'
        printf 'in the same position, including the ones that spawn a CLI.\n'
    fi
    record "paid-endpoint guard" FAIL ""
fi

# ---------------------------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------------------------

printf '\n%s\n' "$RULE_HEAVY"
printf '%s SUMMARY%s\n' "$BOLD" "$RESET"
printf '%s\n' "$RULE_HEAVY"

i=0
while [ "$i" -lt "${#gate_names[@]}" ]; do
    verdict="${gate_verdicts[$i]}"
    note="${gate_notes[$i]}"
    case "$verdict" in
        PASS) colour="$GREEN" ;;
        WARN) colour="$YELLOW" ;;
        *) colour="$RED" ;;
    esac
    if [ -n "$note" ]; then
        printf '  %s%s%s  %-16s %s\n' "$colour" "$verdict" "$RESET" "${gate_names[$i]}" "$note"
    else
        printf '  %s%s%s  %s\n' "$colour" "$verdict" "$RESET" "${gate_names[$i]}"
    fi
    i=$((i + 1))
done

warnings=0
failed_names=""
i=0
while [ "$i" -lt "${#gate_names[@]}" ]; do
    case "${gate_verdicts[$i]}" in
        WARN) warnings=$((warnings + 1)) ;;
        FAIL) failed_names="${failed_names:+$failed_names, }${gate_names[$i]}" ;;
    esac
    i=$((i + 1))
done

printf '\n'
if [ "$failures" -eq 0 ]; then
    if [ "$warnings" -gt 0 ]; then
        printf '%sAll %s gates passed%s, with %s warning(s) above - nothing to fix, only to know.\n' \
            "$GREEN" "$TOTAL_GATES" "$RESET" "$warnings"
    else
        printf '%sAll %s gates passed.%s\n' "$GREEN" "$TOTAL_GATES" "$RESET"
    fi
    exit 0
fi

printf '%s%s of %s gates failed: %s%s\n' "$RED" "$failures" "$TOTAL_GATES" "$failed_names" "$RESET"
printf 'Each failure printed its own output above, under its GATE heading.\n'
exit 1
